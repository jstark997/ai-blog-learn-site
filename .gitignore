# ============================================================
# ai-blog-learn-site
# Editorial content (content/), docs/, scripts/, .claude/skills,
# .claude/agents, .claude/commands and pnpm-lock.yaml are all
# version-controlled on purpose. Do not add them here.
# ============================================================

# --- Dependencies ------------------------------------------------------------
node_modules
.pnp
.pnp.*

# --- Build output ------------------------------------------------------------
/.next/
/out/
/build/
/coverage/
.turbo/
*.tsbuildinfo
next-env.d.ts

# --- Environment -------------------------------------------------------------
# Never commit real values. .env.example IS committed: it documents
# NEXT_PUBLIC_SITE_URL and SHOW_DRAFTS for the next person and the next agent.
.env
.env.*
!.env.example

# --- Secrets and keys --------------------------------------------------------
*.pem
*.key
*.p12

# --- Deployment --------------------------------------------------------------
.vercel

# --- Logs --------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.pnpm-debug.log*

# --- Claude Code -------------------------------------------------------------
# Skills, agents and commands ARE committed — they are shared project tooling.
# Only machine-local state is ignored.
.claude/settings.local.json
.claude/projects/
.claude/*.lock
.ignore/

# --- Browser automation ------------------------------------------------------
# Snapshots, console logs and screenshots written by the Playwright MCP server
# during an accessibility or responsive review. Working notes, not artefacts.
.playwright-mcp/

# --- Editor / OS -------------------------------------------------------------
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
