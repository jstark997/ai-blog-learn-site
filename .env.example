# Canonical site URL. Used by page metadata, the sitemap and the RSS feed
# (application spec §25). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional override for draft visibility (application spec §16).
# Normally unset: drafts show in development and on preview deployments,
# and are hidden in production. Set to false to preview a production build
# locally with drafts hidden.
# SHOW_DRAFTS=false
